  "scripts": {
    "check:typespec": "tsp compile validation/typespec/validation.tsp --emit=@typespec/json-schema --option @typespec/json-schema.file-type=json --option @typespec/json-schema.seal-object-schemas=true --output-dir .tmp/typespec"
