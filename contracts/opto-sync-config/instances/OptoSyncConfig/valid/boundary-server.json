{
  "version": 1,
  "mode": "server",
  "strict": true,
  "flags2env": {
    "contract": ".cli-flags.toml",
    "require_audit": true,
    "precedence": "argv-over-env"
  },
  "sync": {
    "push_interval_ms": 100,
    "pull_interval_ms": 3600000,
    "max_batch_size": 10000,
    "conflict_policy": "manual"
  },
  "env": [
    {
      "name": "a123456789012345678901234567890123456789012345678901234567890123",
      "key": "OPTO_SYNC_BIND",
      "kind": "string",
      "required": false,
      "secret": false,
      "default": "127.0.0.1:8080",
      "description": "64-character binding-name boundary fixture"
    }
  ],
  "server": {
    "enabled": true,
    "bind_addr_binding": "a123456789012345678901234567890123456789012345678901234567890123"
  }
}
