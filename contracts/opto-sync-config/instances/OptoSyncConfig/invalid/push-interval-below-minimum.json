{
  "version": 1,
  "mode": "server",
  "strict": true,
  "flags2env": {
    "contract": ".cli-flags.toml",
    "require_audit": true,
    "precedence": "argv-over-env"
  },
  "sync": {
    "push_interval_ms": 99,
    "pull_interval_ms": 1000,
    "max_batch_size": 32,
    "conflict_policy": "server-wins"
  },
  "env": [],
  "server": {
    "enabled": true
  }
}
